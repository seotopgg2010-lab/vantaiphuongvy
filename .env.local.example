# Copy to .env.local for local runs. On Vercel, set the same keys under
# Settings → Environment Variables (Production). Never commit real values.

# Quote form delivery (src/lib/lead-delivery.ts): configure at least one channel.
# The form shows "call the hotline" instead of accepting requests when none is set.

# Phương Vy's own Supabase project (Project Settings → API). Every request is stored
# in contact_leads; create it once with supabase/migrations/001_contact_leads.sql.
# The service-role key is server-only: never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram bot from @BotFather and the chat or group that receives each request.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional JSON webhook (Zapier, Make, n8n, Google Apps Script, CRM…).
LEAD_WEBHOOK_URL=
